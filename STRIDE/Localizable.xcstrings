    "Finished runs are saved to Health with their distance, duration and route. STRIDE never reads your Health data." : {
      "comment" : "Footnote of the Health card",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendete Läufe werden mit Distanz, Dauer und Strecke in Health gesichert. STRIDE liest deine Health-Daten nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las carreras terminadas se guardan en Salud con su distancia, duración y ruta. STRIDE nunca lee tus datos de Salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les courses terminées sont enregistrées dans Santé avec leur distance, leur durée et leur parcours. STRIDE ne lit jamais vos données Santé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le corse terminate vengono salvate in Salute con distanza, durata e percorso. STRIDE non legge mai i tuoi dati di Salute."
