    "The app was closed during your run. The time it was closed is not counted. Resume or finish." : {
      "comment" : "Shown when the app was killed during a run",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App wurde während deines Laufs geschlossen. Die Zeit, in der sie geschlossen war, wird nicht gezählt. Setze fort oder beende den Lauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app se cerró durante tu carrera. El tiempo que estuvo cerrada no se cuenta. Reanuda o termina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app a été fermée pendant votre course. Le temps de fermeture n’est pas compté. Reprenez ou terminez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app è stata chiusa durante la tua corsa. Il tempo in cui è rimasta chiusa non viene conteggiato. Riprendi o termina."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app foi fechado durante sua corrida. O tempo em que ficou fechado não é contado. Retome ou finalize."
          }
        }
      }
    },
