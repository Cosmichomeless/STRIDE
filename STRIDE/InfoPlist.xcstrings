{
  "sourceLanguage" : "en",
  "strings" : {
    "NSHealthShareUsageDescription" : {
      "comment" : "Health read prompt: never shown, STRIDE reads nothing; Apple requires the key because HealthKit is linked",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STRIDE liest keine deiner Health-Daten. Apple verlangt diesen Hinweis, weil die App deine Läufe in Health sichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STRIDE does not read your Health data. Apple requires this note because the app saves your runs to Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STRIDE no lee tus datos de Salud. Apple exige este aviso porque la app guarda tus carreras en Salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STRIDE ne lit aucune de vos données Santé. Apple exige cette mention car l’app enregistre vos courses dans Santé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STRIDE non legge i tuoi dati di Salute. Apple richiede questa nota perché l’app salva le tue corse in Salute."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O STRIDE não lê seus dados do Saúde. A Apple exige este aviso porque o app salva suas corridas no Saúde."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Health permission prompt: STRIDE only writes workouts",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STRIDE sichert deine beendeten Läufe mit Distanz, Dauer und Strecke in Health."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STRIDE saves your finished runs to Health with their distance, duration and route."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STRIDE guarda tus carreras terminadas en Salud, con su distancia, duración y ruta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STRIDE enregistre vos courses terminées dans Santé, avec leur distance, leur durée et leur parcours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STRIDE salva le tue corse terminate in Salute, con distanza, durata e percorso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O STRIDE salva suas corridas finalizadas no Saúde, com distância, duração e percurso."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Location permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STRIDE verwendet deinen Standort, um Strecke, Distanz und Pace deiner Läufe aufzuzeichnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STRIDE uses your location to record the route, distance and pace of your runs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STRIDE usa tu ubicación para registrar la ruta, la distancia y el ritmo de tus carreras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STRIDE utilise votre position pour enregistrer le parcours, la distance et l’allure de vos courses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STRIDE usa la tua posizione per registrare percorso, distanza e ritmo delle tue corse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O STRIDE usa sua localização para gravar o percurso, a distância e o ritmo das suas corridas."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
